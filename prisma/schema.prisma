generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
  FREEZE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  FREEZE
}

enum Role {
  SUPERADMIN
  ADMIN
  STUDENT
  TEACHER
  MANAGEMENT
  ADMINSTRATOR
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum WeekDays {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum HomeworkStatus {
  APPROVED
  PENDING
  NOT_REVIEWED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
}

enum PaymentMethod {
  PAYME
  MANUAL
}

/// Davomat holati. `isPresent` eski kod bilan mos ishlashi uchun saqlanadi,
/// `status` esa "kechikdi" / "sababli" kabi holatlarni ham ifodalaydi.
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELED
}

/// Xabarnoma kimga mo'ljallangani.
///
/// ORGANIZATION — aniq bir tashkilotga (o'sha tashkilotga biriktirilgan
/// foydalanuvchilarga), USER — aniq bir shaxsga (admin / o'qituvchi / o'quvchi).
enum NotificationAudience {
  ALL
  ADMINS
  TEACHERS
  STUDENTS
  GROUP
  ORGANIZATION
  USER
}

enum NotificationType {
  INFO
  WARNING
  PAYMENT
  LESSON
  HOMEWORK
  SYSTEM
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum GradeType {
  LESSON
  HOMEWORK
  EXAM
  BEHAVIOR
  OTHER
}

model User {
  id             Int        @id @default(autoincrement())
  fullName       String
  phone          String     @unique
  photo          String?
  password       String
  position       String
  hire_date      DateTime
  role           Role
  address        String?
  status         UserStatus @default(ACTIVE)
  organizationId Int?
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  groups          Group[]
  attendances     Attendance[]
  lessons         Lesson[]
  homework        Homework[]
  lessonVideos    LessonVideo[]
  homeworkResults HomeworkResult[]
  studentGroups   StudentGroup[]
  exams           Exam[]
  examResults     ExamResult[]
  grades          Grade[]

  @@index([organizationId])
}

model Teacher {
  id         Int        @id @default(autoincrement())
  fullName   String
  phone      String     @unique
  photo      String?
  password   String
  position   String
  experience Int
  status     UserStatus @default(ACTIVE)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  groups          Group[]
  attendances     Attendance[]
  lessons         Lesson[]
  homework        Homework[]
  lessonVideos    LessonVideo[]
  ratings         Rating[]
  homeworkResults HomeworkResult[]
  exams           Exam[]
  examResults     ExamResult[]
  grades          Grade[]
}

model Student {
  id         Int        @id @default(autoincrement())
  fullName   String
  phone      String     @unique
  photo      String?
  password   String
  birth_date DateTime
  status     UserStatus @default(ACTIVE)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  studentGroups     StudentGroup[]
  payments          Payment[]
  attendances       Attendance[]
  homeworkResults   HomeworkResult[]
  homeworkResponses HomeworkResponse[]
  examResponses     ExamResponse[]
  examResults       ExamResult[]
  grades            Grade[]
}

model Course {
  id             Int          @id @default(autoincrement())
  name           String       @unique
  durationMonth  Int
  durationLesson Int
  status         Status       @default(ACTIVE)
  level          CourseLevel?
  price          Decimal
  description    String?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  groups   Group[]
  payments Payment[]
  exams    Exam[]
}

model Room {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  capacity   Int
  status     Status   @default(ACTIVE)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  groups Group[]
}


model Group {
  id         Int        @id @default(autoincrement())
  teacherId  Int
  userId     Int
  roomId     Int
  courseId   Int
  name       String     @unique
  startDate  DateTime
  startTime  String
  weekDays   WeekDays[]
  status     Status     @default(ACTIVE)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  studentGroup  StudentGroup[]
  payments      Payment[]
  teacher       Teacher        @relation(fields: [teacherId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  room          Room           @relation(fields: [roomId], references: [id])
  course        Course         @relation(fields: [courseId], references: [id])
  lessons       Lesson[]
  exams         Exam[]
  grades        Grade[]
  notifications Notification[]

  @@unique([courseId, name])
}


model StudentGroup {
  id         Int      @id @default(autoincrement())
  userId     Int
  groupId    Int
  studentId  Int
  status     Status   @default(ACTIVE)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  group   Group   @relation(fields: [groupId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([groupId, studentId])
}


model Payment {
  id         Int            @id @default(autoincrement())
  studentId  Int
  groupId    Int
  courseId   Int
  amount     Decimal
  status     PaymentStatus  @default(PENDING)
  method     PaymentMethod?
  year       Int
  month      Int
  paidAt     DateTime?
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  group   Group   @relation(fields: [groupId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  paymeTransactions PaymeTransaction[]

  @@unique([studentId, groupId, year, month])
}

/**
 * Payme Merchant API tranzaksiyasi.
 *
 * Payme bitta to'lov uchun bir necha marta so'rov yuborishi mumkin (tarmoq
 * uzilishi, qayta urinish). `paycomId` unique bo'lgani uchun takroriy so'rov
 * yangi yozuv yaratmaydi - shu orqali idempotentlik ta'minlanadi.
 *
 * Vaqtlar Payme talabiga ko'ra millisekundda (Unix epoch) saqlanadi.
 */
model PaymeTransaction {
  id          Int     @id @default(autoincrement())
  paycomId    String  @unique
  paycomTime  BigInt
  createTime  BigInt  @default(0)
  performTime BigInt  @default(0)
  cancelTime  BigInt  @default(0)
  /// Payme summani tiyinda yuboradi (1 so'm = 100 tiyin).
  amount      Decimal
  /// 1 - yaratilgan, 2 - bajarilgan, -1 - bekor qilingan, -2 - bajarilgandan keyin bekor qilingan
  state       Int     @default(1)
  reason      Int?

  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([paymentId])
  @@index([paycomTime])
  @@index([state])
}


model Lesson {
  id         Int      @id @default(autoincrement())
  groupId    Int
  title      String
  userId     Int?
  teacherId  Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  group        Group         @relation(fields: [groupId], references: [id])
  teacher      Teacher?      @relation(fields: [teacherId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  attendances  Attendance[]
  homework     Homework[]
  lessonVideos LessonVideo[]
  ratings      Rating[]
  grades       Grade[]
  exams        Exam[]
}

model Attendance {
  id         Int              @id @default(autoincrement())
  lessonId   Int
  userId     Int?
  teacherId  Int?
  studentId  Int
  isPresent  Boolean
  status     AttendanceStatus @default(ABSENT)
  comment    String?
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  teacher Teacher? @relation(fields: [teacherId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  student Student  @relation(fields: [studentId], references: [id])
  lesson  Lesson   @relation(fields: [lessonId], references: [id])
}

model Homework {
  id           Int       @id @default(autoincrement())
  lessonId     Int
  userId       Int?
  groupId      Int
  teacherId    Int?
  title        String
  file         String?
  durationTime Int       @default(16)
  dueDate      DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  teacher           Teacher?           @relation(fields: [teacherId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  lesson            Lesson             @relation(fields: [lessonId], references: [id])
  homeworkResults   HomeworkResult[]
  homeworkResponses HomeworkResponse[]
}

model LessonVideo {
  id         Int      @id @default(autoincrement())
  lessonId   Int
  groupId    Int
  userId     Int?
  teacherId  Int?
  file       String
  created_at DateTime @default(now())

  teacher Teacher? @relation(fields: [teacherId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  lesson  Lesson   @relation(fields: [lessonId], references: [id])
}

model HomeworkResponse {
  id         Int      @id @default(autoincrement())
  homeworkId Int
  studentId  Int
  title      String
  file       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  student  Student  @relation(fields: [studentId], references: [id])
  homework Homework @relation(fields: [homeworkId], references: [id])
}

model HomeworkResult {
  id         Int            @id @default(autoincrement())
  homeworkId Int
  studentId  Int
  userId     Int?
  teacherId  Int?
  title      String
  file       String?
  comment    String?
  score      Int
  status     HomeworkStatus
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  teacher  Teacher? @relation(fields: [teacherId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id])
  homework Homework @relation(fields: [homeworkId], references: [id])
}

model Rating {
  id         Int      @id @default(autoincrement())
  teacherId  Int
  lessonId   Int
  score      Int
  created_at DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id])
  lesson  Lesson  @relation(fields: [lessonId], references: [id])
}

model LoginLog {
  id         Int      @id @default(autoincrement())
  userPhone  String
  ipAddress  String
  deviceName String?
  location   String?
  userAgent  String?
  loginType  String   @default("user")
  success    Boolean  @default(true)
  created_at DateTime @default(now())
}

enum VerificationPurpose {
  REGISTER
  RESET_PASSWORD
  CHANGE_PHONE
}

model VerificationCode {
  id         Int                 @id @default(autoincrement())
  phone      String
  code       String
  purpose    VerificationPurpose @default(REGISTER)
  expiresAt  DateTime
  attempts   Int                 @default(0)
  verifiedAt DateTime?
  created_at DateTime            @default(now())

  @@index([phone, purpose])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  userId     Int
  userType   String
  expiresAt  DateTime
  created_at DateTime @default(now())
}

model Exam {
  id           Int       @id @default(autoincrement())
  groupId      Int
  lessonId     Int
  courseId     Int?
  teacherId    Int?
  userId       Int?
  title        String
  description  String?
  file         String?
  startAt      DateTime
  endAt        DateTime
  dueDate      DateTime?
  durationTime Int       @default(60)
  maxScore     Int       @default(100)
  status       Status    @default(ACTIVE)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course    Course?        @relation(fields: [courseId], references: [id])
  teacher   Teacher?       @relation(fields: [teacherId], references: [id])
  user      User?          @relation(fields: [userId], references: [id])
  responses ExamResponse[]
  results   ExamResult[]
  grades    Grade[]
}

model ExamResponse {
  id         Int      @id @default(autoincrement())
  examId     Int
  studentId  Int
  title      String?
  comment    String?
  file       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

model ExamResult {
  id         Int            @id @default(autoincrement())
  examId     Int
  studentId  Int
  teacherId  Int?
  userId     Int?
  comment    String?
  score      Int
  status     HomeworkStatus @default(NOT_REVIEWED)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@unique([examId, studentId])
}


model Organization {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  phone        String?
  address      String?
  logo         String?
  directorName String?
  description  String?
  status       Status   @default(ACTIVE)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  users          User[]
  subscriptions  Subscription[]
  supportTickets SupportTicket[]
  notifications  Notification[]
}


model Plan {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  price         Decimal
  durationMonth Int      @default(1)
  maxStudents   Int?
  maxTeachers   Int?
  maxGroups     Int?
  description   String?
  features      String[]
  status        Status   @default(ACTIVE)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id             Int                @id @default(autoincrement())
  organizationId Int
  planId         Int
  startDate      DateTime           @default(now())
  endDate        DateTime
  amount         Decimal
  status         SubscriptionStatus @default(PENDING)
  paidAt         DateTime?
  canceledAt     DateTime?
  comment        String?
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId, status])
  @@index([status, endDate])
}


model Notification {
  id             Int                  @id @default(autoincrement())
  title          String
  message        String
  type           NotificationType     @default(INFO)
  audience       NotificationAudience @default(ALL)
  groupId        Int?
  organizationId Int?
  /// audience = USER bo'lganda — aniq qabul qiluvchi. Ism ko'rsatish uchun
  /// nusxa qilib saqlanadi, chunki hisoblar uch xil jadvalda joylashgan.
  recipientRole  Role?
  recipientId    Int?
  recipientName  String?
  createdByRole  Role?
  createdById    Int?
  createdByName  String?
  created_at     DateTime             @default(now())

  group        Group?             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reads        NotificationRead[]

  @@index([audience, created_at])
  @@index([recipientRole, recipientId])
}


model NotificationRead {
  id             Int      @id @default(autoincrement())
  notificationId Int
  recipientRole  Role
  recipientId    Int
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, recipientRole, recipientId])
}


model SupportTicket {
  id             Int             @id @default(autoincrement())
  organizationId Int?
  subject        String
  message        String
  status         SupportStatus   @default(OPEN)
  priority       SupportPriority @default(NORMAL)
  createdByRole  Role
  createdById    Int
  createdByName  String?
  contactPhone   String?
  closedAt       DateTime?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@index([status, created_at])
}


model SupportMessage {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  senderRole Role
  senderId   Int
  senderName String?
  message    String
  created_at DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}


model Grade {
  id         Int       @id @default(autoincrement())
  studentId  Int
  groupId    Int
  lessonId   Int?
  examId     Int?
  teacherId  Int?
  userId     Int?
  type       GradeType @default(LESSON)
  score      Int
  maxScore   Int       @default(100)
  comment    String?
  date       DateTime  @default(now())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lesson  Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  exam    Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  teacher Teacher? @relation(fields: [teacherId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([studentId, groupId])
  @@index([groupId, date])
}
