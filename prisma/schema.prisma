generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
  FREEZE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  FREEZE
}

enum Role {
  SUPERADMIN
  ADMIN
  STUDENT
  TEACHER
  MANAGEMENT
  ADMINSTRATOR
  /// Buxgalter — faqat moliya bo'limi (/api/v2).
  ACCOUNTANT
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum WeekDays {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum HomeworkStatus {
  APPROVED
  PENDING
  NOT_REVIEWED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
}

enum PaymentMethod {
  PAYME
  MANUAL
  /// Naqd pul (`naqd`).
  CASH
  /// Plastik karta (`karta`).
  CARD
  /// Bank o'tkazmasi (`perechisleniya`).
  TRANSFER
}

/// Davomat holati. `isPresent` eski kod bilan mos ishlashi uchun saqlanadi,
/// `status` esa "kechikdi" / "sababli" kabi holatlarni ham ifodalaydi.
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELED
}

/// Xabarnoma kimga mo'ljallangani.
/// ORGANIZATION — aniq bir tashkilotga (o'sha tashkilotga biriktirilgan
/// foydalanuvchilarga), USER — aniq bir shaxsga (admin / o'qituvchi / o'quvchi).
enum NotificationAudience {
  ALL
  ADMINS
  TEACHERS
  STUDENTS
  GROUP
  ORGANIZATION
  USER
}

enum NotificationType {
  INFO
  WARNING
  PAYMENT
  LESSON
  HOMEWORK
  SYSTEM
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum GradeType {
  LESSON
  HOMEWORK
  EXAM
  BEHAVIOR
  OTHER
}

/// Kurs turi: namunadagi "Tezkor" va "Avto maktab" filtri.
enum CourseType {
  EXPRESS
  AUTO_SCHOOL
}

model User {
  id                 Int        @id @default(autoincrement())
  fullName           String
  phone              String     @unique
  photo              String?
  password           String
  position           String
  hire_date          DateTime
  role               Role
  address            String?
  status             UserStatus @default(ACTIVE)
  organizationId     Int?
  email              String?    @unique
  /// Yangi panel bilan tanishtiruv (CRM tour) tugatilgan yoki o'tkazib yuborilgan vaqt.
  crmTourCompletedAt DateTime?
  /// Xodimning asosiy filiali (menejer, operator, buxgalter).
  branchId           Int?
  /// Ruxsatlar qo'lda sozlangan bo'lsa — versiya va ro'yxat (/api/v2).
  accessVersion      Int        @default(0)
  permissions        Json?
  /// O'chirilgan xodim — qator qoladi, "O'chirilganlar"da ko'rinadi.
  deleted_at         DateTime?
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branch          Branch?          @relation("UserHomeBranch", fields: [branchId], references: [id], onDelete: SetNull)
  managedBranches Branch[]
  groups          Group[]
  attendances     Attendance[]
  lessons         Lesson[]
  homework        Homework[]
  lessonVideos    LessonVideo[]
  homeworkResults HomeworkResult[]
  studentGroups   StudentGroup[]
  exams           Exam[]
  examResults     ExamResult[]
  grades          Grade[]
  leads           Lead[]
  expenses        Expense[]

  @@index([organizationId])
}

model Teacher {
  id             Int        @id @default(autoincrement())
  fullName       String
  phone          String     @unique
  photo          String?
  password       String
  position       String
  experience     Int
  status         UserStatus @default(ACTIVE)
  organizationId Int?
  /// Yangi panelga kirish uchun (ixtiyoriy).
  email          String?    @unique
  /// THEORY — nazariya, PRACTICE — amaliy haydash ustozi.
  specialization String     @default("THEORY")
  branchId       Int?
  accessVersion  Int        @default(0)
  permissions    Json?
  deleted_at     DateTime?
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branch          Branch?          @relation("TeacherBranch", fields: [branchId], references: [id], onDelete: SetNull)
  groups          Group[]
  attendances     Attendance[]
  lessons         Lesson[]
  homework        Homework[]
  lessonVideos    LessonVideo[]
  ratings         Rating[]
  homeworkResults HomeworkResult[]
  exams           Exam[]
  examResults     ExamResult[]
  grades          Grade[]

  @@index([organizationId])
}

model Student {
  id             Int        @id @default(autoincrement())
  fullName       String
  phone          String     @unique
  photo          String?
  password       String
  birth_date     DateTime?
  status         UserStatus @default(ACTIVE)
  organizationId Int?
  branchId       Int?

  // --- /api/v2 (Automaktab paneli) maydonlari ---
  firstName           String?
  lastName            String?
  middleName          String?
  email               String?
  passportSeries      String?
  passportNumber      String?
  gender              String?
  address             String?
  courseType          CourseType?
  courseId            Int?
  /// O'quvchi bilan kelishilgan umumiy narx. Bo'sh bo'lsa — guruh kursi narxi.
  totalPrice          Decimal?
  paymentMethod       PaymentMethod?
  /// active | completed | dropped | suspended
  lifecycle           String         @default("active")
  /// oqimoqda | topshirdi | yiqildi
  result              String         @default("oqimoqda")
  hasDocument         Boolean        @default(false)
  o83                 Boolean        @default(false)
  contractNumber      String?
  notes               String?
  startDate           DateTime?
  completionDate      DateTime?
  leadSource          String?
  leadSourceOther     String?
  referredByStudentId Int?
  referredByUserId    String?
  registeredById      Int?
  /// O'quvchi portaliga kirish paroli o'rnatilganmi.
  hasLearnerAccount   Boolean        @default(false)
  deleted_at          DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  course            Course?            @relation("StudentCourse", fields: [courseId], references: [id], onDelete: SetNull)
  studentGroups     StudentGroup[]
  payments          Payment[]
  attendances       Attendance[]
  homeworkResults   HomeworkResult[]
  homeworkResponses HomeworkResponse[]
  examResponses     ExamResponse[]
  examResults       ExamResult[]
  grades            Grade[]
  studentExams      StudentExam[]

  @@index([organizationId])
  @@index([branchId])
}

model Course {
  id             Int          @id @default(autoincrement())
  name           String
  durationMonth  Int
  durationLesson Int
  status         Status       @default(ACTIVE)
  level          CourseLevel?
  type           CourseType   @default(AUTO_SCHOOL)
  price          Decimal
  description    String?
  organizationId Int?
  branchId       Int?
  /// Kurs davomiyligi kunlarda (/api/v2).
  durationDays   Int?
  deleted_at     DateTime?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branch       Branch?       @relation("CourseBranch", fields: [branchId], references: [id], onDelete: SetNull)
  students     Student[]     @relation("StudentCourse")
  groups       Group[]
  payments     Payment[]
  exams        Exam[]
  leads        Lead[]

  // Kurs nomi tashkilot ichida takrorlanmaydi; boshqa tashkilotda esa
  // xuddi shu nomdagi kurs bo'lishi mumkin.
  @@unique([organizationId, name])
  @@index([organizationId])
}

model Room {
  id             Int      @id @default(autoincrement())
  name           String
  capacity       Int
  status         Status   @default(ACTIVE)
  organizationId Int?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  groups       Group[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Group {
  id             Int        @id @default(autoincrement())
  teacherId      Int?
  userId         Int?
  roomId         Int?
  courseId       Int?
  name           String
  startDate      DateTime?
  startTime      String?
  weekDays       WeekDays[]
  status         Status     @default(ACTIVE)
  organizationId Int?
  branchId       Int?
  courseType     CourseType @default(AUTO_SCHOOL)
  deleted_at     DateTime?
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  organization  Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branch        Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  studentGroup  StudentGroup[]
  payments      Payment[]
  teacher       Teacher?           @relation(fields: [teacherId], references: [id])
  user          User?              @relation(fields: [userId], references: [id])
  room          Room?              @relation(fields: [roomId], references: [id])
  course        Course?            @relation(fields: [courseId], references: [id])
  lessons       Lesson[]
  exams         Exam[]
  grades        Grade[]
  notifications Notification[]
  templates     ScheduleTemplate[]

  // Guruh nomi kurs ichida takrorlanmaydi. Kurs allaqachon bitta tashkilotga
  // tegishli, ya'ni bu cheklov tashkilotlar orasida to'qnashmaydi.
  @@unique([courseId, name])
  @@index([organizationId])
  @@index([branchId])
}

model StudentGroup {
  id         Int      @id @default(autoincrement())
  userId     Int?
  groupId    Int
  studentId  Int
  status     Status   @default(ACTIVE)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user    User?   @relation(fields: [userId], references: [id])
  group   Group   @relation(fields: [groupId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([groupId, studentId])
}

model Payment {
  id             Int            @id @default(autoincrement())
  studentId      Int
  groupId        Int?
  courseId       Int?
  amount         Decimal
  status         PaymentStatus  @default(PENDING)
  method         PaymentMethod?
  year           Int
  month          Int
  paidAt         DateTime?
  /// /api/v2: kim qabul qildi va takroriy so'rovdan himoya kaliti.
  branchId       Int?
  recordedById   Int?
  recordedByName String?
  idempotencyKey String?        @unique
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  group   Group?  @relation(fields: [groupId], references: [id])
  course  Course? @relation(fields: [courseId], references: [id])

  paymeTransactions PaymeTransaction[]

  @@index([studentId, groupId, year, month])
  @@index([branchId, paidAt])
}

/**
 * Payme Merchant API tranzaksiyasi.
 * Payme bitta to'lov uchun bir necha marta so'rov yuborishi mumkin (tarmoq
 * uzilishi, qayta urinish). `paycomId` unique bo'lgani uchun takroriy so'rov
 * yangi yozuv yaratmaydi - shu orqali idempotentlik ta'minlanadi.
 * Vaqtlar Payme talabiga ko'ra millisekundda (Unix epoch) saqlanadi.
 */
model PaymeTransaction {
  id          Int     @id @default(autoincrement())
  paycomId    String  @unique
  paycomTime  BigInt
  createTime  BigInt  @default(0)
  performTime BigInt  @default(0)
  cancelTime  BigInt  @default(0)
  /// Payme summani tiyinda yuboradi (1 so'm = 100 tiyin).
  amount      Decimal
  /// 1 - yaratilgan, 2 - bajarilgan, -1 - bekor qilingan, -2 - bajarilgandan keyin bekor qilingan
  state       Int     @default(1)
  reason      Int?

  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([paymentId])
  @@index([paycomTime])
  @@index([state])
}

model Lesson {
  id         Int       @id @default(autoincrement())
  groupId    Int
  title      String
  userId     Int?
  teacherId  Int?
  /// Dars vaqti (/api/v2). Eski darslarda bo'sh — `created_at` ishlatiladi.
  date       DateTime?
  /// theory | practice
  lessonType String    @default("theory")
  /// Jadval shablonidan yaratilgan bo'lsa.
  templateId Int?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  group        Group         @relation(fields: [groupId], references: [id])
  teacher      Teacher?      @relation(fields: [teacherId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  attendances  Attendance[]
  homework     Homework[]
  lessonVideos LessonVideo[]
  ratings      Rating[]
  grades       Grade[]
  exams        Exam[]
}

model Attendance {
  id         Int              @id @default(autoincrement())
  lessonId   Int
  userId     Int?
  teacherId  Int?
  studentId  Int
  isPresent  Boolean
  status     AttendanceStatus @default(ABSENT)
  comment    String?
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  teacher Teacher? @relation(fields: [teacherId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  student Student  @relation(fields: [studentId], references: [id])
  lesson  Lesson   @relation(fields: [lessonId], references: [id])
}

model Homework {
  id           Int       @id @default(autoincrement())
  lessonId     Int
  userId       Int?
  groupId      Int
  teacherId    Int?
  title        String
  file         String?
  durationTime Int       @default(16)
  dueDate      DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  teacher           Teacher?           @relation(fields: [teacherId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  lesson            Lesson             @relation(fields: [lessonId], references: [id])
  homeworkResults   HomeworkResult[]
  homeworkResponses HomeworkResponse[]
}

model LessonVideo {
  id         Int      @id @default(autoincrement())
  lessonId   Int
  groupId    Int
  userId     Int?
  teacherId  Int?
  file       String
  created_at DateTime @default(now())

  teacher Teacher? @relation(fields: [teacherId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  lesson  Lesson   @relation(fields: [lessonId], references: [id])
}

model HomeworkResponse {
  id         Int      @id @default(autoincrement())
  homeworkId Int
  studentId  Int
  title      String
  file       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  student  Student  @relation(fields: [studentId], references: [id])
  homework Homework @relation(fields: [homeworkId], references: [id])
}

model HomeworkResult {
  id         Int            @id @default(autoincrement())
  homeworkId Int
  studentId  Int
  userId     Int?
  teacherId  Int?
  title      String
  file       String?
  comment    String?
  score      Int
  status     HomeworkStatus
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  teacher  Teacher? @relation(fields: [teacherId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id])
  homework Homework @relation(fields: [homeworkId], references: [id])
}

model Rating {
  id         Int      @id @default(autoincrement())
  teacherId  Int
  lessonId   Int
  score      Int
  created_at DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id])
  lesson  Lesson  @relation(fields: [lessonId], references: [id])
}

model LoginLog {
  id         Int      @id @default(autoincrement())
  userPhone  String
  ipAddress  String
  deviceName String?
  location   String?
  userAgent  String?
  loginType  String   @default("user")
  success    Boolean  @default(true)
  created_at DateTime @default(now())

  /**
   * Log yozilayotgan paytda hisob qaysi tashkilotda edi. Tashkilot admini
   * faqat o'z xodimlarining urinishlarini ko'rishi uchun kerak — hisobni
   * keyin qidirib topish esa ishonchsiz, chunki raqam almashishi mumkin.
   */
  organizationId Int?

  // "Shu raqamga qancha muvaffaqiyatsiz urinish bo'ldi" va "shu IP dan
  // qancha" - brute-force tekshiruvining ikkala savoli ham shu indekslarga
  // tayanadi.
  @@index([userPhone, created_at])
  @@index([ipAddress, created_at])
  @@index([organizationId, success, created_at])
}

enum VerificationPurpose {
  REGISTER
  RESET_PASSWORD
  CHANGE_PHONE
}

model VerificationCode {
  id         Int                 @id @default(autoincrement())
  phone      String
  code       String
  purpose    VerificationPurpose @default(REGISTER)
  expiresAt  DateTime
  attempts   Int                 @default(0)
  verifiedAt DateTime?
  created_at DateTime            @default(now())

  @@index([phone, purpose])
}

/**
 * Bitta qurilmadagi bitta sessiya.
 * `sessionId` access token ichiga `sid` bo'lib yoziladi, shuning uchun bu
 * jadvaldagi qator o'chirilishi bilan o'sha access token ham darhol kuchini
 * yo'qotadi — muddati tugashini kutish shart emas.
 * `token` — refresh tokenning ochiq matni emas, sha256 hash'i. Baza sizib
 * chiqsa ham undan ishlaydigan sessiya yasab bo'lmaydi.
 */
model RefreshToken {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  sessionId  String    @unique
  userId     Int
  userType   String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  userAgent  String?
  ipAddress  String?
  created_at DateTime  @default(now())

  @@index([userId, userType])
  @@index([expiresAt])
}

model Exam {
  id           Int       @id @default(autoincrement())
  groupId      Int
  lessonId     Int
  courseId     Int?
  teacherId    Int?
  userId       Int?
  title        String
  description  String?
  file         String?
  startAt      DateTime
  endAt        DateTime
  dueDate      DateTime?
  durationTime Int       @default(60)
  maxScore     Int       @default(100)
  status       Status    @default(ACTIVE)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course    Course?        @relation(fields: [courseId], references: [id])
  teacher   Teacher?       @relation(fields: [teacherId], references: [id])
  user      User?          @relation(fields: [userId], references: [id])
  responses ExamResponse[]
  results   ExamResult[]
  grades    Grade[]
}

model ExamResponse {
  id         Int      @id @default(autoincrement())
  examId     Int
  studentId  Int
  title      String?
  comment    String?
  file       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

model ExamResult {
  id         Int            @id @default(autoincrement())
  examId     Int
  studentId  Int
  teacherId  Int?
  userId     Int?
  comment    String?
  score      Int
  status     HomeworkStatus @default(NOT_REVIEWED)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@unique([examId, studentId])
}

model Organization {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  phone        String?
  address      String?
  logo         String?
  directorName String?
  description  String?
  status       Status   @default(ACTIVE)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  users          User[]
  subscriptions  Subscription[]
  supportTickets SupportTicket[]
  notifications  Notification[]

  // Tashkilotning o'z ma'lumotlari — boshqa tashkilot ularni ko'rmaydi.
  teachers Teacher[]
  students Student[]
  courses  Course[]
  rooms    Room[]
  groups   Group[]
  leads    Lead[]
  expenses Expense[]
  branches Branch[]
}

/// Tashkilot filiali. Guruh va oʻquvchi bitta filialga biriktiriladi.
model Branch {
  id             Int      @id @default(autoincrement())
  name           String
  address        String?
  phone          String?
  managerId      Int?
  status         Status   @default(ACTIVE)
  organizationId Int
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager      User?        @relation(fields: [managerId], references: [id], onDelete: SetNull)
  groups       Group[]
  students     Student[]
  staff        User[]       @relation("UserHomeBranch")
  teachers     Teacher[]    @relation("TeacherBranch")
  courses      Course[]     @relation("CourseBranch")

  @@unique([organizationId, name])
}

/// Lid voronkasidagi bosqich. Tartib doskadagi ustunlar tartibiga mos.
enum LeadStage {
  NEW
  CONTACTED
  TRIAL
  CONTRACT
  WON
  LOST
}

/// Bo'lajak o'quvchi: hali ro'yxatdan o'tmagan, lekin qiziqish bildirgan odam.
model Lead {
  id             Int       @id @default(autoincrement())
  fullName       String
  phone          String
  source         String?
  note           String?
  stage          LeadStage @default(NEW)
  courseId       Int?
  assignedToId   Int?
  /// Keyingi bog'lanish vaqti. O'tib ketgan bo'lsa lid "kechikkan" hisoblanadi.
  nextContactAt  DateTime?
  status         Status    @default(ACTIVE)
  organizationId Int?

  // --- /api/v2 (Automaktab paneli) maydonlari ---
  branchId          Int?
  firstName         String?
  lastName          String?
  email             String?
  courseType        CourseType?
  category          String?
  sourceOther       String?
  referrerStudentId Int?
  referrerStaffId   Int?
  desiredGroupId    Int?
  stageId           Int?
  stageEnteredAt    DateTime    @default(now())
  lastTouchAt       DateTime    @default(now())
  marketingConsent  Boolean     @default(false)
  lostReason        String?
  lostReasonOther   String?
  studentId         Int?
  convertedAt       DateTime?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  referrer          String?
  landing           String?
  version           Int         @default(1)
  createdById       Int?
  deleted_at        DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  stageConfig  LeadStageConfig? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  activities   LeadActivity[]
  course       Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  assignedTo   User?            @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId, stage])
  @@index([assignedToId])
}

enum ExpenseStatus {
  PENDING
  PAID
  /// Qisman to'langan (/api/v2).
  PARTIALLY_PAID
  /// Bekor qilingan majburiyat (/api/v2).
  CANCELLED
}

/// Markaz xarajati (ijara, oylik, kommunal va h.k.).
model Expense {
  id             Int           @id @default(autoincrement())
  title          String
  category       String
  amount         Decimal
  status         ExpenseStatus @default(PENDING)
  /// To'lash muddati. PENDING holatda o'tib ketsa "muddati o'tgan" bo'ladi.
  dueDate        DateTime?
  paidAt         DateTime?
  note           String?
  createdById    Int?
  /// O'chirilgan xarajat yo'qolmaydi — "O'chirilganlar tarixi"da ko'rinadi.
  deleted_at     DateTime?
  organizationId Int?

  // --- /api/v2 maydonlari ---
  branchId       Int?
  vehicleId      Int?
  /// O'qituvchi hisob-kitobi (`teacher_settlement`) uchun — Teacher.id.
  teacherId      Int?
  /// `YYYY-MM` — o'qituvchi hisob-kitobi oyi.
  periodMonth    String?
  expenseDate    DateTime?
  payee          String?
  paidAmount     Decimal   @default(0)
  version        Int       @default(1)
  reviewedAt     DateTime?
  reviewedById   Int?
  idempotencyKey String?   @unique
  cancelledAt    DateTime?
  cancelReason   String?
  deleteReason   String?
  /// Avtomatik yaratilgan bo'lsa manbasi (masalan `fuel`).
  sourceType     String?
  sourceId       Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  payments     ExpensePayment[]
  events       ExpenseEvent[]

  @@index([organizationId, status])
  @@index([organizationId, dueDate])
}

model Plan {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  price         Decimal
  durationMonth Int      @default(1)
  maxStudents   Int?
  maxTeachers   Int?
  maxGroups     Int?
  description   String?
  features      String[]
  status        Status   @default(ACTIVE)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id             Int                @id @default(autoincrement())
  organizationId Int
  planId         Int
  startDate      DateTime           @default(now())
  endDate        DateTime
  amount         Decimal
  status         SubscriptionStatus @default(PENDING)
  paidAt         DateTime?
  canceledAt     DateTime?
  comment        String?
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId, status])
  @@index([status, endDate])
}

model Notification {
  id             Int                  @id @default(autoincrement())
  title          String
  message        String
  type           NotificationType     @default(INFO)
  audience       NotificationAudience @default(ALL)
  groupId        Int?
  organizationId Int?
  /// audience = USER bo'lganda — aniq qabul qiluvchi. Ism ko'rsatish uchun
  /// nusxa qilib saqlanadi, chunki hisoblar uch xil jadvalda joylashgan.
  recipientRole  Role?
  recipientId    Int?
  recipientName  String?
  createdByRole  Role?
  createdById    Int?
  createdByName  String?
  created_at     DateTime             @default(now())

  group        Group?             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reads        NotificationRead[]

  @@index([audience, created_at])
  @@index([recipientRole, recipientId])
}

model NotificationRead {
  id             Int      @id @default(autoincrement())
  notificationId Int
  recipientRole  Role
  recipientId    Int
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, recipientRole, recipientId])
}

model SupportTicket {
  id             Int             @id @default(autoincrement())
  organizationId Int?
  subject        String
  message        String
  status         SupportStatus   @default(OPEN)
  priority       SupportPriority @default(NORMAL)
  createdByRole  Role
  createdById    Int
  createdByName  String?
  contactPhone   String?
  closedAt       DateTime?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@index([status, created_at])
}

model SupportMessage {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  senderRole Role
  senderId   Int
  senderName String?
  message    String
  created_at DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Grade {
  id         Int       @id @default(autoincrement())
  studentId  Int
  groupId    Int
  lessonId   Int?
  examId     Int?
  teacherId  Int?
  userId     Int?
  type       GradeType @default(LESSON)
  score      Int
  maxScore   Int       @default(100)
  comment    String?
  date       DateTime  @default(now())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lesson  Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  exam    Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  teacher Teacher? @relation(fields: [teacherId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([studentId, groupId])
  @@index([groupId, date])
}

// ===========================================================================
// /api/v2 — Automaktab tenant paneli (autodrive-frontend) uchun modellar.
//
// Xodim havolalari (`authorId`, `instructorId`, ...) matn ko'rinishida
// saqlanadi: `User` id'si — "12", `Teacher` id'si — "t12". Ikki jadvalning
// ID hisoblagichi alohida, frontend esa ularni bitta "xodimlar" ro'yxatida
// ko'radi (qarang: v2.mapper.ts).
// ===========================================================================

/// Har bir yozish amali (yaratish / o'zgartirish / o'chirish) izi.
model AuditLog {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  branchId       Int?
  /// CREATE | UPDATE | DELETE
  action         String
  entity         String
  entityId       String
  actorId        String?
  actorName      String?
  actorRole      String?
  changes        Json?
  created_at     DateTime @default(now())

  @@index([organizationId, created_at])
  @@index([entity, entityId])
}

/// Guruhning haftalik dars jadvali (bitta qator — haftaning bitta kuni).
model ScheduleTemplate {
  id         Int      @id @default(autoincrement())
  groupId    Int
  /// 1 = Dushanba ... 7 = Yakshanba
  dayOfWeek  Int
  startTime  String
  endTime    String
  /// theory | practice
  lessonType String   @default("theory")
  isActive   Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

/// Davlat imtihoni natijasi (nazariya / amaliyot).
model StudentExam {
  id          Int      @id @default(autoincrement())
  studentId   Int
  /// THEORY | PRACTICE
  examType    String
  score       Int?
  passed      Boolean
  notes       String?
  date        DateTime @default(now())
  createdById String?
  created_at  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

/// Ruxsatlar shabloni (tashkilot ichida qayta ishlatiladigan to'plam).
model PermissionTemplate {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  permissions    String[]
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([organizationId, name])
}

/// Lid voronkasi bosqichi (tashkilot o'zi sozlaydi).
model LeadStageConfig {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  /// NEW | WORK | WON | LOST
  kind           String
  position       Int
  color          String   @default("#3B82F6")
  isSystem       Boolean  @default(false)
  isActive       Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  leads Lead[]

  @@index([organizationId])
}

/// Tashkilotning qo'shimcha lid manbalari.
model LeadSourceConfig {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  isSystem       Boolean  @default(false)
  isActive       Boolean  @default(true)
  created_at     DateTime @default(now())

  @@unique([organizationId, name])
}

model LeadActivity {
  id         Int       @id @default(autoincrement())
  leadId     Int
  /// NOTE | CALL | MESSAGE | MEETING | TASK | STAGE_CHANGE | SYSTEM
  kind       String
  body       String?
  dueAt      DateTime?
  doneAt     DateTime?
  authorId   String?
  authorName String?
  meta       Json?
  created_at DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, created_at])
}

/// Xarajat bo'yicha bitta to'lov. Bekor qilingan to'lov o'chmaydi.
model ExpensePayment {
  id             Int           @id @default(autoincrement())
  expenseId      Int
  amount         Decimal
  method         PaymentMethod
  date           DateTime
  note           String?
  recordedById   String
  idempotencyKey String        @unique
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  created_at     DateTime      @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model ExpenseEvent {
  id               Int      @id @default(autoincrement())
  expenseId        Int
  expensePaymentId Int?
  action           String
  changes          Json?
  actorId          String
  actorName        String
  actorRole        String
  created_at       DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId, created_at])
}

/// Xodimning Telegram bog'lanishi va xabarnoma sozlamalari.
model TelegramLink {
  id                 Int       @id @default(autoincrement())
  /// "12" yoki "t12"
  actorId            String    @unique
  chatId             String?
  linkToken          String?   @unique
  linkTokenExpiresAt DateTime?
  dailyReport        Boolean   @default(false)
  expenseDigest      Boolean   @default(false)
  digestSnoozedUntil DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
}

/// Saytdan kelgan demo so'rovi.
model DemoRequest {
  id           Int      @id @default(autoincrement())
  fullName     String
  phone        String
  region       String
  centerName   String?
  studentCount String?
  note         String?
  source       String   @default("web")
  /// new | contacted | archived
  status       String   @default("new")
  created_at   DateTime @default(now())
}

/// Bazada saqlanadigan fayl (chek rasmi, ko'rik surati, savol diagrammasi).
model StoredFile {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  mimeType       String
  size           Int
  sha256         String
  data           Bytes
  created_at     DateTime @default(now())
}

// --- Avtopark ---------------------------------------------------------------

model Vehicle {
  id                 Int      @id @default(autoincrement())
  organizationId     Int
  branchId           Int
  plateNumber        String
  vin                String?
  make               String
  model              String
  manufactureYear    Int
  categories         String[]
  odometerKm         Int      @default(0)
  /// active | out_of_service | retired
  status             String   @default("active")
  /// Mashina biriktirilgan ustoz/xodim: "12" yoki "t12".
  currentCustodianId String?
  fuelTypes          String[] @default([])
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  documents   VehicleDocument[]
  maintenance VehicleMaintenance[]
  transfers   VehicleTransfer[]
  inspections VehicleInspection[]
  defects     VehicleDefect[]
  fuelRecords FuelRecord[]
  sessions    DrivingSession[]

  @@unique([organizationId, plateNumber])
  @@index([branchId])
}

model VehicleDocument {
  id         Int       @id @default(autoincrement())
  vehicleId  Int
  /// registration | insurance | technical_inspection | other
  type       String
  label      String
  reference  String?
  expiresOn  DateTime?
  created_at DateTime  @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model VehicleMaintenance {
  id                Int       @id @default(autoincrement())
  vehicleId         Int
  description       String
  startedAt         DateTime
  completedAt       DateTime?
  nextDueOn         DateTime?
  nextDueOdometerKm Int?
  created_at        DateTime  @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model VehicleTransfer {
  id              Int      @id @default(autoincrement())
  vehicleId       Int
  fromBranchId    Int
  toBranchId      Int
  reason          String
  transferredById String
  transferredAt   DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

/// Mashinani qabul qilish / topshirish ko'rigi.
model VehicleInspection {
  id             Int      @id @default(autoincrement())
  organizationId Int
  branchId       Int
  vehicleId      Int
  requestId      String   @unique
  authorId       String
  receiverId     String
  /// acceptance | return
  kind           String
  /// draft | submitted | approved | rejected
  status         String   @default("draft")
  odometerKm     Int
  notes          String?
  overrideReason String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  vehicle  Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  evidence InspectionEvidence[]
  reviews  InspectionReview[]

  @@index([organizationId, created_at])
}

model InspectionEvidence {
  id           Int      @id @default(autoincrement())
  inspectionId Int
  /// front | back | left | right | odometer | defect
  slot         String
  note         String?
  fileId       Int
  mimeType     String
  size         Int
  created_at   DateTime @default(now())

  inspection VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model InspectionReview {
  id           Int      @id @default(autoincrement())
  inspectionId Int
  actorId      String
  /// approve | retake | service | stop
  decision     String
  reason       String?
  created_at   DateTime @default(now())

  inspection VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model VehicleDefect {
  id             Int       @id @default(autoincrement())
  vehicleId      Int
  inspectionId   Int?
  description    String
  /// open | resolved
  status         String    @default("open")
  fileId         Int?
  reportedAt     DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, status])
}

// --- Yoqilg'i ---------------------------------------------------------------

model FuelStation {
  id             Int      @id @default(autoincrement())
  organizationId Int
  branchId       Int
  name           String
  stir           String?
  address        String?
  contact        String?
  active         Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  records         FuelRecord[]
  reconciliations FuelReconciliation[]

  @@index([organizationId, branchId])
}

model FuelRecord {
  id             Int      @id @default(autoincrement())
  organizationId Int
  branchId       Int
  vehicleId      Int
  stationId      Int
  requestId      String   @unique
  authorId       String
  /// draft | submitted | approved | rejected | cancelled
  status         String   @default("draft")
  /// manual_review | source_verified
  sourceStatus   String   @default("manual_review")
  sourceData     Json?
  occurredAt     DateTime
  odometerKm     Int
  /// partner_credit | school_card | advance | personal
  fundingSource  String
  qrUrl          String?
  /// [{ fuel_type, unit, quantity, unit_price, line_total, name?, mxik? }]
  lines          Json
  total          Decimal
  expenseId      Int?
  version        Int      @default(1)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  vehicle  Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  station  FuelStation    @relation(fields: [stationId], references: [id], onDelete: Restrict)
  evidence FuelEvidence[]
  history  FuelHistory[]

  @@index([organizationId, created_at])
  @@index([vehicleId, occurredAt])
}

model FuelEvidence {
  id           Int      @id @default(autoincrement())
  fuelRecordId Int
  /// receipt | odometer
  slot         String
  fileId       Int
  created_at   DateTime @default(now())

  record FuelRecord @relation(fields: [fuelRecordId], references: [id], onDelete: Cascade)
}

model FuelHistory {
  id           Int      @id @default(autoincrement())
  fuelRecordId Int
  action       String
  changes      Json?
  reason       String?
  actorId      String
  created_at   DateTime @default(now())

  record FuelRecord @relation(fields: [fuelRecordId], references: [id], onDelete: Cascade)
}

model FuelReconciliation {
  id              Int      @id @default(autoincrement())
  stationId       Int
  requestId       String   @unique
  statementAmount Decimal
  discrepancy     Decimal
  reason          String
  actorId         String
  created_at      DateTime @default(now())

  station FuelStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
}

// --- Amaliy mashg'ulotlar ---------------------------------------------------

model TrainingProgram {
  id              Int        @id @default(autoincrement())
  organizationId  Int
  branchId        Int
  courseId        Int?
  name            String
  courseType      CourseType
  category        String
  requiredMinutes Int
  isActive        Boolean    @default(true)
  approvedById    String
  approvedAt      DateTime   @default(now())
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  enrollments TrainingEnrollment[]

  @@index([organizationId, branchId])
}

model TrainingEnrollment {
  id             Int      @id @default(autoincrement())
  organizationId Int
  branchId       Int
  studentId      Int
  programId      Int?
  /// legacy | active | completed | cancelled
  status         String   @default("active")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  program  TrainingProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  sessions DrivingSession[]

  @@index([organizationId, branchId])
  @@index([studentId])
}

model DrivingSession {
  id                   Int       @id @default(autoincrement())
  organizationId       Int
  branchId             Int
  enrollmentId         Int
  studentId            Int
  vehicleId            Int
  /// Faqat amaliy (PRACTICE) ustoz — "t12".
  instructorId         String
  startsAt             DateTime
  endsAt               DateTime
  /// planned | submitted | approved | rejected | cancelled
  status               String    @default("planned")
  plannedMinutes       Int
  actualMinutes        Int?
  approvedMinutes      Int       @default(0)
  gpsExceptionReason   String?
  submittedAt          DateTime?
  submittedById        String?
  reviewedAt           DateTime?
  reviewedById         String?
  rejectionReason      String?
  cancellationReason   String?
  lastCorrectionReason String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  vehicle    Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([organizationId, startsAt])
  @@index([vehicleId, startsAt])
  @@index([instructorId, startsAt])
}

// --- Savollar bazasi va testlar ---------------------------------------------

model Question {
  id                 Int       @id @default(autoincrement())
  organizationId     Int?
  branchId           Int?
  /// platform_public | school_private
  visibility         String    @default("school_private")
  /// draft | in_review | published | retired | disputed
  status             String    @default("draft")
  category           String    @default("B")
  topic              String
  authorId           String
  reviewerId         String?
  publishedVersionId Int?
  draftVersionId     Int?
  publishedAt        DateTime?
  retiredAt          DateTime?
  disputedAt         DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  versions QuestionVersion[]
  media    QuestionMedia[]

  @@index([organizationId, status])
}

model QuestionVersion {
  id               Int       @id @default(autoincrement())
  questionId       Int
  versionNumber    Int
  correctOptionKey String
  sourceUrl        String?
  legalProvision   String?
  diagramMediaId   Int?
  /// [{ locale, stem, explanation, options: [{ option_key, text, sort_order }] }]
  locales          Json
  publishedAt      DateTime?
  created_at       DateTime  @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, versionNumber])
}

model QuestionMedia {
  id              Int      @id @default(autoincrement())
  questionId      Int
  fileId          Int
  mimeType        String
  byteSize        Int
  sha256          String
  altText         String
  rightsBasis     String
  rightsHolder    String
  rightsConfirmed Boolean
  created_at      DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model TestTemplate {
  id                      Int       @id @default(autoincrement())
  organizationId          Int
  branchId                Int
  createdById             String
  title                   String
  description             String?
  category                String    @default("B")
  /// draft | published | archived
  status                  String    @default("draft")
  questionCount           Int
  timeLimitSeconds        Int
  passingThresholdPercent Int
  availableFrom           DateTime?
  availableUntil          DateTime?
  retryLimit              Int       @default(1)
  shuffleQuestions        Boolean   @default(true)
  shuffleOptions          Boolean   @default(false)
  answerReviewTiming      String    @default("after_submit")
  /// Tartiblangan savol id'lari.
  questionIds             Int[]
  publishedAt             DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  assignments TestAssignment[]

  @@index([organizationId, branchId])
}

model TestAssignment {
  id             Int       @id @default(autoincrement())
  templateId     Int
  organizationId Int
  branchId       Int
  groupId        Int?
  studentId      Int?
  assignedById   String
  availableFrom  DateTime?
  availableUntil DateTime?
  created_at     DateTime  @default(now())

  template TestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}
