# ============================================================
#  SERVER .env  (/root/crm-lms-backend/.env)
#  Bu fayl docker-compose tomonidan 2 xil ishlatiladi:
#    1) ${DB_USER} kabi o'zgaruvchilar compose'ning O'ZI uchun
#    2) qolganlari `env_file` orqali app konteyneriga uzatiladi
# ============================================================

# ---------- 1. POSTGRES KONTEYNERI ----------
# DIQQAT: bular faqat BIRINCHI marta (volume bo'sh bo'lganda) qo'llanadi.
# Keyin o'zgartirsangiz - `docker compose down -v` qilish shart.
DB_USER=postgres
DB_PASSWORD=ParolniShuYergaYozing
DB_NAME=crm_lms

# ---------- 2. ILOVA -> BAZA ULANISHI (MAJBURIY) ----------
# host = "db" (konteyner nomi), "localhost" EMAS!
# user/parol/baza nomi yuqoridagi 3 ta qiymat bilan bir xil bo'lsin.
# Parolda @ : / ? # belgilari bo'lsa - URL-encode qiling (@ -> %40)
DATABASE_URL="postgresql://postgres:ParolniShuYergaYozing@db:5432/crm_lms"

# ---------- 3. REDIS ----------
REDIS_PASSWORD=RedisParolniShuYergaYozing

# ---------- 4. JWT (MAJBURIY) ----------
# Bo'sh bo'lsa ilova ishga tushmaydi (auth.module.ts throw qiladi).
# Yaratish: openssl rand -hex 32
JWT_SECRET=

# ---------- 5. PORT ----------
PORT=3000

# ---------- 6. SUPERADMIN (birinchi kirish uchun) ----------
# EMAIL yoki PASSWORD bo'sh bo'lsa - superadmin YARATILMAYDI va tizimga kira olmaysiz.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FULLNAME="Super Admin"
# Faqat quyidagilardan biri: SUPERADMIN | ADMIN | STUDENT | TEACHER | MANAGEMENT | ADMINSTRATOR
SUPERADMIN_ROLE=SUPERADMIN
SUPERADMIN_POSIT=ADMIN

# ---------- 7. EMAIL (Gmail App Password) ----------
GMAIL_USER=
GMAIL_PASS=

# ---------- 8. CLOUDINARY (rasm/fayl yuklash) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- 9. TO'LOV (ixtiyoriy - bo'sh qolsa ham ishlaydi) ----------
PAYME_MERCHANT_ID=
PAYME_CHECKOUT_URL=
