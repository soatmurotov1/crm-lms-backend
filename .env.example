DB_USER=postgres
DB_PASSWORD=ParolniShuYergaYozing
DB_NAME=crm_lms
DATABASE_URL="postgresql://postgres:ParolniShuYergaYozing@db:5432/crm_lms"


REDIS_PASSWORD=RedisParolniShuYergaYozing

# ---------- 4. JWT (MAJBURIY) ----------
# Bo'sh bo'lsa ilova ishga tushmaydi (auth.module.ts throw qiladi).
# Yaratish: openssl rand -hex 32
JWT_SECRET=

# ---------- 5. PORT ----------
PORT=3000

# ---------- 6. SUPERADMIN (birinchi kirish uchun) ----------
# PHONE yoki PASSWORD bo'sh bo'lsa - superadmin YARATILMAYDI va tizimga kira olmaysiz.
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=
SUPERADMIN_FULLNAME="Super Admin"
# Faqat quyidagilardan biri: SUPERADMIN | ADMIN | STUDENT | TEACHER | MANAGEMENT | ADMINSTRATOR
SUPERADMIN_ROLE=SUPERADMIN
SUPERADMIN_POSIT=ADMIN

# ---------- 7. CLOUDINARY (rasm/fayl yuklash) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- 8. SMS (Eskiz.uz) ----------
# SMS_LOGIN = Eskiz kabinetiga kiradigan email
# SMS_PASSWORD = Eskiz kabinetidan olinadigan API parol (token EMAS)
# SMS_FROM = tasdiqlangan nick, Eskiz'da standarti 4546
# Bo'sh qolsa ilova ishlayveradi, faqat SMS yuborilmaydi (log'da ogohlantirish).
SMS_LOGIN=
SMS_PASSWORD=
SMS_FROM=4546

# ---------- 9. TO'LOV (ixtiyoriy - bo'sh qolsa ham ishlaydi) ----------
PAYME_MERCHANT_ID=
PAYME_CHECKOUT_URL=
# Payme kabinetidan olinadigan MAXFIY kalit (Merchant API uchun).
# Webhook aynan shu kalit bilan tekshiriladi - bo'sh bo'lsa Payme'dan
# keladigan hamma so'rov rad etiladi va to'lovlar tasdiqlanmaydi.
# Payme kabinetida "Endpoint URL" maydoniga quyidagini yozing:
#   https://<domeningiz>/api/payments/payme
PAYME_KEY=
