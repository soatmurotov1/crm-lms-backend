DB_USER=postgres
DB_PASSWORD=
DB_NAME=edu_lms
# Lokal: postgresql://postgres:<parol>@localhost:5432/edu_lms
DATABASE_URL=


REDIS_PASSWORD=
# Kamida 32 belgi. Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Frontend VITE_API_BASE_URL shu portga qaraydi: http://localhost:4040/api/v2
PORT=4040

# Development'da har qanday http://localhost:<port> ruxsat etiladi.
CORS_ORIGIN=http://localhost:8080

NODE_ENV=
SWAGGER_ENABLED=

# Nechta HTTP worker ko'tariladi. Bo'sh yoki 0 - CPU soniga qarab avtomatik
# (eng ko'pi 8). 1 - cluster o'chadi, bitta process (development/debug uchun).
WEB_CONCURRENCY=

# Cron job'lar shu process'da ishlaydimi. Cluster'da buni primary o'zi
# faqat bitta worker'ga beradi - qo'lda to'ldirish SHART EMAS.
# Faqat docker replica'lar ishlatilsa kerak bo'ladi: web replica'larda
# "false", alohida worker servisida "true".
SCHEDULER_ENABLED=

# --- DB connection pool (process boshiga) ---
# Bo'sh qoldirilsa: DB_CONNECTION_BUDGET / worker soni.
# Postgres max_connections (standart 100) dan oshib ketmasligi uchun
# budjet ataylab 60 qilingan - qolgani migratsiya, backup va psql uchun.
DB_POOL_MAX=
DB_CONNECTION_BUDGET=60
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX_LIFETIME_SECONDS=1800

# --- Lokal / demo seed (node prisma/seed.mjs) ---
# Tashkilot, "Asosiy filial" va egasi (owner) hisobini yaratadi.
SEED_OWNER_EMAIL=owner@educrm.local
# Kamida 8 belgi, bosh harf va raqam bilan (masalan: Kuchli#Parol2026).
SEED_OWNER_PASSWORD=
SEED_OWNER_PHONE=998900000001
SEED_ORG_NAME="EduLMS o'quv markazi"

SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=
SUPERADMIN_FULLNAME="Super Admin"
SUPERADMIN_ROLE=SUPERADMIN
SUPERADMIN_POSIT=ADMIN


CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMS_LOGIN=
SMS_PASSWORD=
SMS_FROM=4546

PAYME_MERCHANT_ID=
PAYME_CHECKOUT_URL=
PAYME_KEY=

# --- /api/v2 (yangi panel) sessiya cookie ---
# Frontend va API bitta saytda bo'lsa bo'sh qoldiring (SameSite=Lax).
# Butunlay boshqa domenlarda tursa: none (cookie faqat HTTPS orqali yuradi).
V2_COOKIE_SAMESITE=
# Masalan .example.uz - subdomenlar o'rtasida bo'lishish uchun. Ixtiyoriy.
V2_COOKIE_DOMAIN=
