DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=


REDIS_PASSWORD=
JWT_SECRET=
PORT=3000

NODE_ENV=
SWAGGER_ENABLED=

# Nechta HTTP worker ko'tariladi. Bo'sh yoki 0 - CPU soniga qarab avtomatik
# (eng ko'pi 8). 1 - cluster o'chadi, bitta process (development/debug uchun).
WEB_CONCURRENCY=

# Cron job'lar shu process'da ishlaydimi. Cluster'da buni primary o'zi
# faqat bitta worker'ga beradi - qo'lda to'ldirish SHART EMAS.
# Faqat docker replica'lar ishlatilsa kerak bo'ladi: web replica'larda
# "false", alohida worker servisida "true".
SCHEDULER_ENABLED=

# --- DB connection pool (process boshiga) ---
# Bo'sh qoldirilsa: DB_CONNECTION_BUDGET / worker soni.
# Postgres max_connections (standart 100) dan oshib ketmasligi uchun
# budjet ataylab 60 qilingan - qolgani migratsiya, backup va psql uchun.
DB_POOL_MAX=
DB_CONNECTION_BUDGET=60
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX_LIFETIME_SECONDS=1800

SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=
SUPERADMIN_FULLNAME="Super Admin"
SUPERADMIN_ROLE=SUPERADMIN
SUPERADMIN_POSIT=ADMIN


CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMS_LOGIN=
SMS_PASSWORD=
SMS_FROM=4546

PAYME_MERCHANT_ID=
PAYME_CHECKOUT_URL=
PAYME_KEY=
